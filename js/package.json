{
  "name": "@guestready/echo-feedback",
  "version": "0.1.1",
  "description": "In-page feedback dialog for Echo: type, message, screenshot and attachments, sent through your own backend.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "modern-screenshot": "4.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guestready/echo-clients.git",
    "directory": "js"
  }
}
